# ------------------------------------------------------------------
# LLM (one OpenAI-compatible client). Works with DeepSeek (default)
# or OpenAI -- change base_url + model together.
# Docs: https://api-docs.deepseek.com
# ------------------------------------------------------------------
OPENAI_API_KEY=sk-your-deepseek-or-openai-key

# DeepSeek (default)
OPENAI_BASE_URL=https://api.deepseek.com
ANALYSIS_MODEL=deepseek-v4-flash

# OpenAI instead: comment the two lines above, uncomment these two
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANALYSIS_MODEL=gpt-4.1

# ---- Optional web-search enrichment (skipped gracefully when absent) ----
TAVILY_API_KEY=

# ---- Knobs (sane defaults; rarely need changing) ----
# DEFAULT_LIMIT=15
# CACHE_TTL_HOURS=24
# HTTP_TIMEOUT_SECONDS=15
# ANALYSIS_TEMPERATURE=0.2

# DeepSeek v4 defaults to extended thinking, which consumes the output budget
# and truncates the JSON analysis. The pipeline disables it by default.
# ANALYSIS_THINKING=disabled
